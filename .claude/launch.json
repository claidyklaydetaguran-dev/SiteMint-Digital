{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-agency",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@workspace/web-agency",
        "run",
        "dev"
      ],
      "port": 22065,
      "autoPort": true,
      "env": {
        "BASE_PATH": "/",
        "API_PROXY_TARGET": "http://localhost:8080"
      }
    },
    {
      "name": "web-agency-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@workspace/web-agency",
        "run",
        "dev"
      ],
      "port": 22066,
      "env": {
        "BASE_PATH": "/",
        "API_PROXY_TARGET": "http://localhost:8090",
        "PORT": "22066"
      }
    }
  ]
}
