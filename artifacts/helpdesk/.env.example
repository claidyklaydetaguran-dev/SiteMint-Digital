# These values are embedded into the dashboard build. Set them in the
# staging/production build environment before building the helpdesk SPA.
# VITE_VAPI_PUBLIC_KEY is explicitly a browser-safe public key. Never use the
# private VAPI_API_KEY in a VITE_ variable.
VITE_VOICE_PLATFORM_ENABLED=false
VITE_VOICE_PUBLISH_ENABLED=false
VITE_VOICE_BROWSER_TEST_ENABLED=false
VITE_VAPI_PUBLIC_KEY=
