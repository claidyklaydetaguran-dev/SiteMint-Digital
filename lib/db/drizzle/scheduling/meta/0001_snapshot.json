          "name": "ck_scheduling_appointment_requests_booked_requires_provider",
          "value": "\"scheduling_appointment_requests\".\"status\" <> 'booked' OR (\"scheduling_appointment_requests\".\"provider_event_id\" IS NOT NULL AND \"scheduling_appointment_requests\".\"provider_calendar_id\" IS NOT NULL)"
