{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/voice": "./src/schema/voice/index.ts",
    "./schema/discovery": "./src/schema/discovery/index.ts",
    "./schema/scheduling": "./src/schema/scheduling/index.ts"
  },
  "scripts": {
    "migrate:fresh": "node ./src/migrate-fresh.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "generate:voice": "drizzle-kit generate --config ./drizzle.voice.config.ts",
    "migrate:voice": "node ./src/migrate-guard.mjs voice",
    "generate:scheduling": "drizzle-kit generate --config ./drizzle.scheduling.config.ts",
    "migrate:scheduling": "node ./src/migrate-guard.mjs scheduling",
    "generate:discovery": "drizzle-kit generate --config ./drizzle.discovery.config.ts",
    "migrate:discovery": "node ./src/migrate-guard.mjs discovery",
    "baseline:journals": "node ./src/baseline-journals.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
